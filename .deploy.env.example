# Copy to .deploy.env on the computer you deploy from.
# This file contains no application secrets; those stay in self-hosting/.env
# on the server.

# SSH host or alias from ~/.ssh/config.
DEPLOY_HOST=moneymatter-server

# Absolute path to the repository checkout on the server.
DEPLOY_PATH=/opt/moneymatter

# Set to false if another process updates the server checkout.
DEPLOY_UPDATE_CODE=true

# Optional SSH port (leave commented when using the default or ~/.ssh/config).
# DEPLOY_SSH_PORT=22
